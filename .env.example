# ==============================================================================
# PocketMate - Environment Variables Configuration
# Duplicate this file as .env.local and update the values.
# ==============================================================================

# Database Connection (Neon PostgreSQL)
# Get a free serverless PostgreSQL database from https://neon.tech
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/pocketmate?sslmode=require"

# Google Gemini API Keys
# Obtain free tier API keys from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"
# Optional: Secondary failover key for rotation / high volume
GEMINI_API_KEY_SECONDARY=""
GEMINI_MODEL="gemini-3.5-flash"

# PayPal Developer Sandbox Credentials
# Create a sandbox app at: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-sandbox-client-secret"
PAYPAL_ENVIRONMENT="sandbox"
# Optional: Sandbox Webhook ID for cryptographic signature verification (/api/paypal/webhook)
PAYPAL_WEBHOOK_ID=""
# Optional: Partner Attribution BN Code (for Platform multi-merchant calls)
PAYPAL_BN_CODE=""
# Optional: Verified platform business email (if invoicing directly as app owner)
PAYPAL_BUSINESS_EMAIL=""
# Optional: Password used when generating git-ignored sandbox-users.csv (npm run csv:paypal)
SANDBOX_DEFAULT_PASSWORD=""

# End-of-Day Scheduled Sweep Secret
# Set any random string here; Render Workflows or external cron pings /api/cron/sweep?secret=...
CRON_SECRET="your-secure-cron-webhook-secret"

# NextAuth / Security Settings
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-random-32-byte-secret"

# AG Studio Pro Enterprise Trial License Key
# Enter your free 45-day evaluation trial key from https://www.ag-grid.com/studio/license-pricing/
AG_STUDIO_LICENSE_KEY=""
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=""

# Bryntum Scheduler Enterprise Trial Key
# Enter your free 45-day evaluation trial key from https://bryntum.com/download/
NEXT_PUBLIC_BRYNTUM_LICENSE_KEY=""




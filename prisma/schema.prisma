generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonaType {
  GENERAL
  FREELANCER
  BUSINESS
}

enum IndustryType {
  TECH_SAAS
  ECOMMERCE_RETAIL
  HOSPITALITY_FOOD
  CREATIVE_STUDIO
  CONSULTING_SERVICES
  HEALTHCARE
  GENERAL_BUSINESS
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
  FAILED
}

enum SplitStatus {
  PENDING_CONFIRMATION
  SENT
  SETTLED
  CANCELLED
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  name                String?
  avatarUrl           String?
  persona             PersonaType      @default(GENERAL)
  industry            IndustryType?
  confidenceThreshold Float            @default(0.80)
  lastSyncedAt        DateTime?
  lastTransactionAt   DateTime?
  lastTransactionId   String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  budgetCategories    BudgetCategory[]
  splitRecords        SplitRecord[]
  chatMessages        ChatMessage[]
  chatThreads         ChatThread[]
  contacts            Contact[]
  scheduledEvents     ScheduledEvent[]
  merchantRules       MerchantCategoryRule[]
  categoryOverrides   TransactionCategoryOverride[]
  ledgerTransactions  LedgerTransaction[]
}

model BudgetCategory {
  id           String        @id @default(cuid())
  userId       String
  name         String
  monthlyCap   Float
  currentSpent   Float         @default(0.0)
  alertThreshold Float?        @default(0.80)
  softCap        Float?
  color          String?       @default("#3b82f6")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries      BudgetEntry[]

  @@unique([userId, name])
}

model BudgetEntry {
  id           String         @id @default(cuid())
  categoryId   String
  amount       Float
  description  String
  merchant     String?
  sourceTxId   String?
  createdAt    DateTime       @default(now())

  category     BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model SplitRecord {
  id           String        @id @default(cuid())
  userId       String
  totalAmount  Float
  status       SplitStatus   @default(PENDING_CONFIRMATION)
  description  String
  itemsJson    Json?         // breakdown details
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        SplitItem[]
}

model SplitItem {
  id               String        @id @default(cuid())
  splitRecordId    String
  participantName  String
  participantEmail String
  amount           Float
  paypalInvoiceId  String?
  status           InvoiceStatus @default(DRAFT)
  createdAt        DateTime      @default(now())

  splitRecord      SplitRecord   @relation(fields: [splitRecordId], references: [id], onDelete: Cascade)
}

model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New Conversation")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id            String       @id @default(cuid())
  userId        String
  threadId      String?
  role          String       // "user" | "assistant" | "system"
  content       String       @db.Text
  toolCallsJson Json?
  persona       PersonaType  @default(GENERAL)
  createdAt     DateTime     @default(now())

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread        ChatThread?  @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model Contact {
  id           String    @id @default(cuid())
  userId       String
  name         String
  email        String
  paypalHandle String?
  lastSplitAt  DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
}

model ScheduledEvent {
  id           String    @id @default(cuid())
  userId       String
  title        String
  amount       Float
  date         String    // YYYY-MM-DD
  dayOfMonth   Int
  type         String    // "incoming" | "outgoing" | "milestone"
  category     String
  counterparty String?
  status       String    // "pending" | "scheduled" | "completed"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MerchantCategoryRule {
  id              String   @id @default(cuid())
  userId          String
  merchantPattern String   // Lowercase normalized merchant string (e.g. "starbucks")
  categoryName    String
  isAutoLearned   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantPattern])
  @@index([userId])
}

model TransactionCategoryOverride {
  id            String   @id @default(cuid())
  userId        String
  transactionId String   // PayPal transaction ID
  categoryName  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, transactionId])
  @@index([userId])
}

model LedgerTransaction {
  id              String   @id @default(cuid())
  userId          String
  paypalId        String
  sourceType      String   // "reporting" | "invoice"
  txType          String   // "merchant" | "p2p" | "split"
  status          String   // "COMPLETED" | "PENDING" | "DRAFT" | "DISPUTED" | "CANCELLED"
  amount          Float
  currency        String   @default("USD")
  merchantName    String
  memo            String?
  timestamp       DateTime
  feeAmount       Float?
  debtorName      String?
  recipientEmail  String?
  invoicerEmail   String?
  direction       String   @default("outgoing") // "incoming" | "outgoing" | "outgoing_split"
  isOutgoingSplit Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paypalId])
  @@index([userId, timestamp])
  @@index([userId, status])
}
